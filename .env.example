# Reference only: Python does not automatically load this file. Set values in PowerShell, for example:
#   $env:AGENT_MODE = "pipeline"

# --- v5 reply writer (hosted model writes the wording; code decides every action) ---
# REPLY_PROVIDER=bedrock       # none (default, built-in templates) | bedrock | anthropic | ollama
# REPLY_MODEL=                 # copy the exact model id or inference profile id from the Bedrock console
# AWS_REGION=us-east-1
# REPLY_TIMEOUT=25             # seconds; on timeout or rejection the built-in reply is used
# AWS credentials: run `aws configure` or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in your shell only.

# --- v4 pipeline (default) --------------------------------------------------
# Code runs the investigation; keyword rules understand most messages instantly.
# The model is asked for ONE short JSON label only when the rules cannot tell what is affected.
AGENT_MODE=pipeline            # pipeline (default) | auto | model | playbook
OLLAMA_URL=http://127.0.0.1:11434
UNDERSTAND_MODEL=llama3.2:3b   # any Ollama model; falls back to AGENT_MODEL, then OLLAMA_MODEL
UNDERSTAND_TIMEOUT=45          # seconds; on timeout the agent asks one clarifying question instead
UNDERSTAND_WITH_MODEL=1        # 0 = never call a model (keyword rules + clarifying question only)
# LLM_PROVIDER=anthropic       # optional hosted model for the understanding call
# ANTHROPIC_API_KEY=           # set in your shell only; never commit it or paste it in chat
# SUPPORT_DB=D:\VOZON\tech-support-agent\data\support.db

# --- older v3 model loop (AGENT_MODE=auto or model; slow on CPU, kept for comparison) ---
# AGENT_MODEL=qwen3:4b
# AGENT_MODEL_TIMEOUT=240
